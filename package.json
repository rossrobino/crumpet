{
	"name": "crumpet",
	"description": "A full-stack toolchain for Bun",
	"version": "0.1.0",
	"author": {
		"name": "Ross Robino",
		"url": "https://robino.dev"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rossrobino/crumpet.git"
	},
	"homepage": "https://github.com/rossrobino/crumpet#readme",
	"bugs": "https://github.com/rossrobino/crumpet/issues",
	"license": "MIT",
	"keywords": [
		"bun",
		"full-stack",
		"ssr"
	],
	"type": "module",
	"engines": {
		"bun": ">=1.4.4"
	},
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"scripts": {
		"build": "bun build.ts",
		"check": "bun check",
		"test": "bun test",
		"prepublishOnly": "bun run check && bun test && bun run build",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@robino/tsconfig": "^3.0.0",
		"@types/bun": "^1.4.4",
		"typescript": "^7.0.2"
	}
}
